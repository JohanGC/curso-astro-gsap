---
import Layout from '@/layouts/Layout.astro';
import Card from '@/components/Card.astro';
import Boton from '@/components/Boton.astro';
import { getCollection } from 'astro:content';

const proyectos = await getCollection('proyectos');
const destacados = proyectos.filter((p: any) => p.data.destacado);

const secciones = [
	{ id: 's1', titulo: 'Seccion1'},
	{ id: 's2', titulo: 'Seccion2'},
	{ id: 's3', titulo: 'Seccion3'},
	{ id: 's4', titulo: 'Seccion4'},
	{ id: 's5', titulo: 'Seccion5'},
]
---

<Layout title="Mi Sitio Web">
	<header class="cabecera">
		<a href="#inicio">Aurora</a>
		<nav aria-label="Principal">
			{secciones.map((s) => <a href={`#${s.id}`} data-enlace={s.id}>{s.titulo}</a>)}
		</nav>
		<button type="button" class="botom-menu" data-menu-boton aria-expanded="false" aria-controls="menu-movil" aria-label="Menu">☰</button>
	</header>

	<div id="menu-movil" class="menu-movil" data-menu hidden>
		{secciones.map((s) => <a href={`#${s.id}`} data-enlace={s.id}>{s.titulo}</a>)}
	</div>

	<main id="contenido">
		{secciones.map((s) => (
			<section id="s.id" data-seccion class="seccion"><h2>{s.titulo}</h2></section>
		))}

		<button class="arriba" type="button" data-arriba aria-label="Volver Arriba">↑</button>

		<script>
			import { initNavigation } from '@/scripts/navigation';
			initNavigation();
		</script>
	</main>
</Layout>