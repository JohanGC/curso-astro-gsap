---
import '@/styles/global.css';
//import { ClientRouter } from 'astro:transitions';

interface Props { title: string; description?: string; imagen?: string }
const { title, description = 'Estudio creativo digital', imagen = '/og.jpg' } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name='description' content={canonica} />
        <link rel='canonical' href={canonica} />
        <meta property='og:title' content={title} />
        <meta property='og:image' content={new URL(imagen, Astro.site)} />
        <meta name='twitter:card' content='summary_large_image' />
        <!-- <ClientRouter /> -->
    </head>
    <body>
        <slot />
    </body>
</html>

<script>
    import { lenis } from '@/scripts/smooth-scroll';
    import { iniciarNav } from "@/scripts/navigation";

    let limpiarNav: (() => void) | null = null;

    document.addEventListener('astro:page-load', () => {
        limpiarNav = iniciarNav();
    });
    document.addEventListener('astro:before-swap', () => {
        limpiarNav?.();
        limpiarNav = null;
    });
    document.addEventListener('astro:after-swap', () => {
        lenis.scrollTo(0, { immediate: true });
    });
</script>