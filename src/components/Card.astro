---
interface Props { titulo: string; texto?: string; }
const { titulo, texto = 'Sin descripción' } = Astro.props;
---

<article class='card'>
    <h3>{titulo}</h3>
    <p>{texto}</p>
</article>

<style>
    .card { padding: 1.5rem; border: 1px solid #ddd; border-radius: 12px; }
    h3 { margin: 0 0 .5rem; }
</style>